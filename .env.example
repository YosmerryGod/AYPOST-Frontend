# Neon PostgreSQL connection string (server-side only; never prefix with VITE_)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required for admin PIN login and signed API sessions
AYPOST_ADMIN_PIN="change-this-to-a-long-unique-pin"
AYPOST_JWT_SECRET="replace-with-at-least-32-random-characters"

# Optional: public URL used by the installed Android app to reach the Vercel API
VITE_API_BASE_URL="https://your-aypost-domain.vercel.app"